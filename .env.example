# 필수: Vault 주소와 토큰 (실제 값은 커밋하지 않는다)
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=

# 선택: native 설정 디렉터리 (기본: 리포의 configs/)
CONFIG_DIR=
# 선택: 서비스별 Basic 인증 비밀번호 JSON, 없으면 설정 API 인증을 끈다 (docs/config-access-auth.md)
CONFIG_CLIENT_CREDENTIALS=
# 선택: Vault 요청 타임아웃(ms, 기본 5000)
VAULT_TIMEOUT_MS=

PORT=3000
# 로그 레벨: trace, debug, info(기본), warn, error
LOG_LEVEL=info
# 요청마다 액세스 로그 한 줄(module HttpAccess). 기본 켜짐, false 일 때만 끈다
HTTP_ACCESS_LOG_ENABLED=true
